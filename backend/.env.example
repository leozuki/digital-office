# ============================================
# Digital Office - Environment Configuration
# ============================================

# --- AI Providers ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Model Selection ---
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-2.0-flash

# Ollama (optional, for local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Agent Runner Assignment ---
# Format: provider:model (provider = anthropic | gemini | ollama)
PLANNER_RUNNER=anthropic:claude-3-5-sonnet-20241022
MANAGER_RUNNER=gemini:gemini-2.0-flash
WORKER_RUNNER=gemini:gemini-2.0-flash
REVIEWER_RUNNER=anthropic:claude-3-5-sonnet-20241022

# --- Server ---
BACKEND_PORT=3001

# --- Security ---
# Mật khẩu quản trị để bảo vệ các route nhạy cảm (Config, Delete)
ADMIN_PASSWORD=admin123456

# CORS: chỉ cho phép origins này (ngăn cách bằng dấu phẩy)
# Production: thêm domain thực của bạn, VD: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Thư mục mặc định để đọc tài liệu (để trống = client tự chỉ định)
# Windows: DEFAULT_DOC_FOLDER=D:\AI\Documents
# Linux:   DEFAULT_DOC_FOLDER=/home/user/documents
DEFAULT_DOC_FOLDER=

# Whitelist thư mục được phép đọc (để trống = không hạn chế — không khuyến khích production)
# VD: ALLOWED_DOC_FOLDERS=/data/documents,/data/uploads
ALLOWED_DOC_FOLDERS=
